NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5174
DATABASE_URL=postgresql://securevault:securevault@localhost:5433/securevault
JWT_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
BCRYPT_SALT_ROUNDS=12
SECUREVAULT_DATA_FILE=./data/securevault.json
# SMTP settings (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=no-reply@securevault.local
